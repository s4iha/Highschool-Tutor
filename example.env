# =============================================================================
# High School Tutor Environment Variables Template (.env.example)
# Copy this file to .env.local for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Local Docker DB credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=highschool_tutor_local
POSTGRES_PORT=5432

# Connection string used by Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/highschool_tutor_local?schema=public"

# -----------------------------------------------------------------------------
# 2. NextAuth.js Authentication
# -----------------------------------------------------------------------------
# Secret key used to encrypt session cookies (Generate via: openssl rand -base64 32)
AUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. Email & Notifications (Resend API)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_sample_api_key_placeholder"
RESEND_FROM_EMAIL="Highschool Tutor <noreply@highschooltutor.ph>"
DEMO_NOTIFICATION_EMAIL="test@example.com"

# -----------------------------------------------------------------------------
# 4. Payment Gateway & Webhooks (GCash / Xendit)
# -----------------------------------------------------------------------------
GCASH_WEBHOOK_SECRET="gcash_webhook_secret_placeholder"
XENDIT_API_KEY="xnd_development_sample_key_placeholder"
XENDIT_WEBHOOK_VERIFICATION_TOKEN="xendit_webhook_token_placeholder"

# -----------------------------------------------------------------------------
# 5. Background Jobs & Cron Maintenance
# -----------------------------------------------------------------------------
# Secret used to secure reminder and subscription maintenance cron endpoints
CRON_SECRET="your-cron-secret-token-placeholder"

# -----------------------------------------------------------------------------
# 6. Admin Credentials (Initial Seeding)
# -----------------------------------------------------------------------------
ADMIN_EMAIL="admin@highschooltutor.ph"
ADMIN_PASSWORD="Admin2026!"

# -----------------------------------------------------------------------------
# 7. Production Docker / GHCR Image
# -----------------------------------------------------------------------------
DOCKER_IMAGE="ghcr.io/username/highschool-tutor:latest"

# -----------------------------------------------------------------------------
# 8. AI PROVIDER
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# 9. Google Authentication 
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""