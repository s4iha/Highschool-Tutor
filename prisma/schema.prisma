generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Better Auth Core Models & Domain Relations
// -----------------------------------------------------------------------------

enum AppRole {
  ADMIN
  STUDENT
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth Relations
  sessions      Session[]
  accounts      Account[]

  // HighSchool Tutor Domain Relations
  profile              Profile?
  roles                UserRole[]
  subscriptions        Subscription[]
  payments             Payment[]
  trialSubjects        TrialSubject[]
  quizAttempts         QuizAttempt[]
  notificationSettings NotificationSettings?
  reminderNotices      ReminderNotice[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      AppRole  @default(STUDENT)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Profile {
  id           String   @id
  fullName     String   @default("")
  email        String   @default("")
  school       String   @default("")
  gradeLevel   String   @default("")
  track        String   @default("")
  hasOnboarded Boolean  @default(false)
  referralCode String   @unique @default(cuid())
  referrer     String   @default("")
  referredById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User      @relation(fields: [id], references: [id], onDelete: Cascade)
  referredBy Profile?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  Profile[] @relation("Referrals")

  @@map("profiles")
}

// -----------------------------------------------------------------------------
// Billing, Subscriptions & Payments
// -----------------------------------------------------------------------------

enum SubPlan {
  MONTHLY
  ANNUAL
}

enum SubStatus {
  TRIAL
  PENDING
  ACTIVE
  EXPIRED
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  plan      SubPlan
  status    SubStatus @default(PENDING)
  amountPhp Int
  startedAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@map("subscriptions")
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amountPhp      Int
  method         String        @default("gcash")
  referenceNo    String
  proofPath      String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime      @default(now())
  verifiedAt     DateTime?
  adminNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// Curriculum & Trials
// -----------------------------------------------------------------------------

model TrialSubject {
  id           String   @id @default(cuid())
  userId       String
  subjectSlug  String
  subjectLabel String   @default("")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectSlug])
  @@index([userId])
  @@map("trial_subjects")
}

model CachedLesson {
  id           String   @id @default(cuid())
  subjectSlug  String   @unique
  subjectLabel String
  lessons      Json
  createdAt    DateTime @default(now())

  @@map("cached_lessons")
}

model CachedQuiz {
  id           String   @id @default(cuid())
  subjectSlug  String
  lessonNumber Int
  lessonTitle  String
  questions    Json
  createdAt    DateTime @default(now())

  @@unique([subjectSlug, lessonNumber])
  @@map("cached_quizzes")
}

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String?
  subjectSlug  String
  subjectCode  String   @default("")
  lessonNumber Int
  lessonTitle  String
  score        Int
  total        Int
  mode         String   @default("study")
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subjectSlug, lessonNumber])
  @@index([subjectSlug, lessonNumber])
  @@map("quiz_attempts")
}

// -----------------------------------------------------------------------------
// Webhooks & Notifications
// -----------------------------------------------------------------------------

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("gcash")
  eventKey    String
  referenceNo String   @default("")
  status      String   @default("")
  payload     Json     @default("{}")
  result      String   @default("")
  createdAt   DateTime @default(now())

  @@unique([provider, eventKey])
  @@map("webhook_events")
}

model NotificationSettings {
  userId       String   @id
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(false)
  phone        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model ReminderNotice {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  periodKey   String   @default("")
  channel     String   @default("email")
  destination String   @default("")
  result      String   @default("sent")
  detail      String   @default("")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey, channel])
  @@map("reminder_notices")
}
