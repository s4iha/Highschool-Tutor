generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Better Auth Core Models & Domain Relations
// -----------------------------------------------------------------------------

enum AppRole {
  ADMIN
  STUDENT
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth Relations
  sessions      Session[]
  accounts      Account[]

  // HighSchool Tutor Domain Relations
  profile              Profile?
  roles                UserRole[]
  subscriptions        Subscription[]
  payments             Payment[]
  trialSubjects        TrialSubject[]
  quizAttempts         QuizAttempt[]
  notificationSettings NotificationSettings?
  reminderNotices      ReminderNotice[]
  aiCreditUsages       AiCreditUsage[]
  quizSessions         QuizSession[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String?   @db.Text
  type                  String?

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      AppRole  @default(STUDENT)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Profile {
  id           String   @id
  fullName     String   @default("")
  email        String   @default("")
  school       String   @default("")
  gradeLevel   String   @default("")
  track        String   @default("")
  termPreference String? @default("")
  tutoringPersona String @default("socratic")
  hasOnboarded     Boolean  @default(false)
  hasCompletedTour Boolean  @default(false)
  referralCode     String   @unique @default(cuid())
  referrer     String   @default("")
  referredById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User      @relation(fields: [id], references: [id], onDelete: Cascade)
  referredBy Profile?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  Profile[] @relation("Referrals")

  @@map("profiles")
}

// -----------------------------------------------------------------------------
// Billing, Subscriptions & Payments
// -----------------------------------------------------------------------------

enum SubPlan {
  MONTHLY
  ANNUAL
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  ALL_LEVELS
}

enum SubStatus {
  TRIAL
  PENDING
  ACTIVE
  EXPIRED
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  plan      SubPlan
  status    SubStatus @default(PENDING)
  amountPhp Int
  startedAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@map("subscriptions")
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amountPhp      Int
  method         String        @default("gcash")
  referenceNo    String
  proofPath      String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime      @default(now())
  verifiedAt     DateTime?
  adminNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// Curriculum & Trials
// -----------------------------------------------------------------------------

model TrialSubject {
  id           String   @id @default(cuid())
  userId       String
  subjectSlug  String
  subjectLabel String   @default("")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectSlug])
  @@index([userId])
  @@map("trial_subjects")
}

model CachedLesson {
  id           String   @id @default(cuid())
  subjectSlug  String   @unique
  subjectLabel String
  lessons      Json
  createdAt    DateTime @default(now())

  @@map("cached_lessons")
}

model CachedQuiz {
  id           String   @id @default(cuid())
  subjectSlug  String
  lessonNumber Int
  lessonTitle  String
  questions    Json
  createdAt    DateTime @default(now())

  @@unique([subjectSlug, lessonNumber])
  @@map("cached_quizzes")
}

model LessonMaterial {
  id           String   @id @default(cuid())
  subjectSlug  String
  lessonNumber Int
  lessonTitle  String
  content      String   @db.Text
  summary      String?  @db.Text
  keyTakeaways Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subjectSlug, lessonNumber])
  @@index([subjectSlug, lessonNumber])
  @@map("lesson_materials")
}

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String?
  subjectSlug  String
  subjectCode  String   @default("")
  lessonNumber Int
  lessonTitle  String
  score        Int
  total        Int
  mode         String   @default("study")
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subjectSlug, lessonNumber])
  @@index([subjectSlug, lessonNumber])
  @@map("quiz_attempts")
}

model QuizSession {
  id            String    @id @default(cuid())
  userId        String?
  subjectSlug   String
  lessonNumber  Int
  lessonTitle   String    @default("")
  mode          String    @default("study")
  questionCount Int       @default(10)
  questions     Json
  userAnswers   Json?
  score         Int?
  total         Int?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subjectSlug, lessonNumber])
  @@map("quiz_sessions")
}

model AiCreditUsage {
  id        String   @id @default(cuid())
  userId    String
  action    String   // "quiz_generation" | "ai_tutor" | "translation"
  credits   Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_credit_usage")
}

// -----------------------------------------------------------------------------
// Webhooks & Notifications
// -----------------------------------------------------------------------------

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("gcash")
  eventKey    String
  referenceNo String   @default("")
  status      String   @default("")
  payload     Json     @default("{}")
  result      String   @default("")
  createdAt   DateTime @default(now())

  @@unique([provider, eventKey])
  @@map("webhook_events")
}

model NotificationSettings {
  userId       String   @id
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(false)
  phone        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model ReminderNotice {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  periodKey   String   @default("")
  channel     String   @default("email")
  destination String   @default("")
  result      String   @default("sent")
  detail      String   @default("")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey, channel])
  @@map("reminder_notices")
}

// -----------------------------------------------------------------------------
// Administration, Broadcasts & System Settings
// -----------------------------------------------------------------------------

enum AnnouncementType {
  INFO
  WARNING
  PROMO
  MAINTENANCE
}

enum AudienceType {
  ALL
  PREMIUM
  TRIAL
}

model AdminConfig {
  id                   String   @id @default(cuid())
  monthlyPricePhp      Int      @default(300)
  annualPricePhp       Int      @default(2600)
  maxTrialSubjects     Int      @default(3)
  maxFreeLessons       Int      @default(3)
  gcashReceiverNumber  String   @default("0917-888-4321")
  gcashAccountName     String   @default("HIGHSCHOOL TUTOR PH")
  mayaReceiverNumber   String   @default("0918-999-8765")
  mayaAccountName      String   @default("HIGHSCHOOL TUTOR PH")
  enableAiTutorTrial   Boolean  @default(true)
  promoDiscountPercent Int      @default(20)
  updatedAt            DateTime @updatedAt

  @@map("admin_config")
}

model Announcement {
  id             String           @id @default(cuid())
  title          String
  body           String           @db.Text
  type           AnnouncementType @default(INFO)
  targetAudience AudienceType     @default(ALL)
  isActive       Boolean          @default(false)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([isActive, targetAudience])
  @@map("announcements")
}

